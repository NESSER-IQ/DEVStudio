{
  "name": "hello-world",
  "displayName": "Hello World Extension",
  "version": "1.0.0",
  "publisher": "sample-publisher",
  "description": "A simple Hello World extension example",
  "author": "Extension Developer",
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "sample",
    "hello-world",
    "example"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:helloWorld.sayHello"
  ],
  "contributes": {
    "commands": [
      {
        "command": "helloWorld.sayHello",
        "title": "Hello World: Say Hello"
      }
    ]
  },
  "engines": {
    "harmonyos": "^1.0.0"
  }
}
